---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Column } from '../data/columns';

interface Props {
  /** このページに表示する記事 */
  items: Column[];
  page: number;
  totalPages: number;
  /** 全記事数 */
  total: number;
}
const { items, page, totalPages, total } = Astro.props;
// 1ページ目は /column/、2ページ目以降は /column/page2/ …（記事URL /column/[slug]/ とは衝突しない）
const pageUrl = (n: number) => (n === 1 ? '/column/' : `/column/page${n}/`);

const pageSuffix = page > 1 ? `（${page}ページ目）` : '';
const title = `ポケカコラム${pageSuffix}｜ポケカ相場ドットコム`;
const description =
  page > 1
    ? `ポケモンカードのデッキ、ルール、大会、梱包について解説したコラムの一覧（${page}/${totalPages}ページ）です。`
    : 'ポケモンカードのデッキ、ルール、大会、梱包について、公式情報を確認しながら分かりやすく解説します。';

// ページネーションに出す番号（先頭/末尾＋現在周辺）
const nums = new Set<number>([1, totalPages, page - 1, page, page + 1]);
const pageList = [...nums].filter((n) => n >= 1 && n <= totalPages).sort((a, b) => a - b);
---

<BaseLayout title={title} description={description} path={pageUrl(page)}>
  <section class="column-index">
    <p class="eyebrow">POKÉCA COLUMN</p>
    <h1>ポケカコラム{pageSuffix}</h1>
    <p class="lead">デッキの組み方から大会・発送まで、ポケカをもっと楽しむための情報をまとめています。（全{total}記事中 {page}/{totalPages}ページ）</p>
    <ul class="column-list">
      {items.map((column) => <li><a href={`/column/${column.slug}/`}><img src={column.images[0].src} alt="" width="360" height="203" loading="lazy" /><div><span>{column.keyword}</span><h2>{column.title}</h2><p>{column.description}</p><b>記事を読む →</b></div></a></li>)}
    </ul>

    {
      totalPages > 1 && (
        <nav class="pager" aria-label="ページ送り">
          {page > 1 && <a class="pg pg-arrow" href={pageUrl(page - 1)}>‹ 前</a>}
          {pageList.map((n, i) => (
            <>
              {i > 0 && pageList[i - 1] !== n - 1 && <span class="pg-gap">…</span>}
              {n === page ? <span class="pg pg-cur">{n}</span> : <a class="pg" href={pageUrl(n)}>{n}</a>}
            </>
          ))}
          {page < totalPages && <a class="pg pg-arrow" href={pageUrl(page + 1)}>次 ›</a>}
        </nav>
      )
    }
  </section>
</BaseLayout>

<style>
  .column-index { max-width: 960px; margin: 0 auto; }
  .eyebrow { margin: 0; color: var(--brand); font-size: 13px; font-weight: 900; letter-spacing: .12em; }
  h1 { margin: 6px 0 10px; color: var(--text-strong); font-size: 36px; }
  .lead { margin: 0 0 28px; color: var(--text-sub); font-weight: 600; }
  .column-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
  .column-list a { display: block; height: 100%; overflow: hidden; color: inherit; border: 1px solid var(--border); border-radius: 14px; background: #fff; box-shadow: var(--shadow-sm); text-decoration: none; transition: transform .2s, box-shadow .2s; }
  .column-list a:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .column-list img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: var(--brand-light); }
  .column-list div { padding: 18px; }
  .column-list span { color: var(--brand); font-size: 12px; font-weight: 900; }
  .column-list h2 { margin: 6px 0 8px; color: var(--text-strong); font-size: 19px; line-height: 1.5; }
  .column-list p { margin: 0; color: var(--text-sub); font-size: 13px; line-height: 1.7; }
  .column-list b { display: block; margin-top: 14px; color: var(--brand); font-size: 13px; }
  .pager { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin-top: 32px; }
  .pg {
    min-width: 38px; text-align: center; padding: 8px 10px; border: 1px solid var(--border);
    border-radius: 8px; text-decoration: none; color: var(--brand); font-weight: 700; background: #fff;
  }
  .pg:hover { background: var(--brand-light); }
  .pg-cur { background: var(--brand); color: #fff; border-color: var(--brand); }
  .pg-arrow { color: var(--text-sub); }
  .pg-gap { align-self: center; color: var(--text-sub); padding: 0 2px; }
  @media (max-width: 640px) { .column-list { grid-template-columns: 1fr; } }
</style>
