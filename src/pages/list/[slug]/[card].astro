---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PriceHistoryChart from '../../../components/PriceHistoryChart.astro';
import ShopLinks from '../../../components/ShopLinks.astro';
import RelatedCards from '../../../components/RelatedCards.astro';
import { purchaseShops, buybackShops, amazonSearchUrl, mercariSearchUrl, toretokuUrl, kanaberuUrl } from '../../../data/affiliates';
import { allCards, getSeriesByName, seriesByPack, priceAsOf, popularByName, sameTypeByName, similarPriceByName, sellInsight } from '../../../data/cards';
import { getPack } from '../../../data/packs';
import { typeColor } from '../../../data/typeColors';
import type { Card } from '../../../data/types';
import pokemonOverview from '../../../../data/pokemon-overview.json';

export function getStaticPaths() {
  const seen = new Set<string>();
  const paths: { params: { slug: string; card: string }; props: { card: Card } }[] = [];
  for (const card of allCards) {
    const cardParam = `${card.cardNumber.replace(/\//g, '-')}-${card.raritySlug}`;
    const key = `${card.nameSlug}/${cardParam}`;
    if (seen.has(key)) continue; // 同一URLの重複を除去（getStaticPaths重複回避）
    seen.add(key);
    paths.push({ params: { slug: card.nameSlug, card: cardParam }, props: { card } });
  }
  return paths;
}

interface Props {
  card: Card;
}
const { card } = Astro.props;

const priceDate = priceAsOf;
const setCode = getPack(card.packSlug)?.setCode ?? card.packSlug.toUpperCase();
const yen = (v: number | null) => (v == null ? '調査中' : `¥${v.toLocaleString('ja-JP')}`);
const surugayaUrl = card.sellShops.find((s) => s.shop === '駿河屋')?.url ?? card.sellShops[0]?.url;
const amazonUrl = amazonSearchUrl(card);
const mercariUrl = mercariSearchUrl(card);
const toretokuSearchUrl = toretokuUrl(card);
const kanaberuSearchUrl = kanaberuUrl(card);
// 販売ショップの駿河屋は当該カードの商品ページに直リンク、Amazon/メルカリ/トレトク/カーナベルは当該カードの検索結果に直リンク
const purchase = purchaseShops.map((s) => {
  if (s.name === '駿河屋' && surugayaUrl) return { ...s, url: surugayaUrl };
  if (s.name === 'Amazon') return { ...s, url: amazonUrl };
  if (s.name === 'メルカリ') return { ...s, url: mercariUrl };
  if (s.name === 'トレトク') return { ...s, url: toretokuSearchUrl };
  if (s.name === 'カーナベル') return { ...s, url: kanaberuSearchUrl };
  return s;
});
const categoryLabel =
  card.category === 'ポケモン' && card.energyType ? `ポケモン・${card.energyType}` : card.category;
const isPokemon = card.category === 'ポケモン';
const listUrl = `/list/${card.nameSlug}/`;

// バトル情報（HP/ワザ/弱点/抵抗力/にげる）。手動サイドデータがあるカードのみ表示。
const detail = card.detail;
const battleType = detail?.type || card.energyType;
// エネルギー記号チップの配色。無（無色）や未知タイプは中立色にフォールバック。
const NEUTRAL: Record<string, { bg: string; fg: string }> = {
  無: { bg: '#e7e1d4', fg: '#6b6250' },
};
const energyStyle = (t: string): string => {
  const c = typeColor(t) ?? NEUTRAL[t] ?? { bg: '#cfd6df', fg: '#33415c' };
  return `background:${c.bg};color:${c.fg}`;
};

// ポケモン概要（生き物としての説明）。nameSlug にデータがあるカードのみ表示（テスト運用）。
const OVERVIEWS = pokemonOverview as Record<string, string>;
const overview = OVERVIEWS[card.nameSlug];
// 概要見出し用にカード名末尾の ex/V 等の表記を除いたポケモン名。
const pokeName = card.name.replace(/\s*(ex|EX|V(MAX|STAR)?|GX)$/g, '').trim();

const otherVariants = (getSeriesByName(card.name)?.variants ?? []).filter((v) => v.id !== card.id);
const samePack = seriesByPack(card.packSlug)
  .filter((s) => s.name !== card.name)
  .map((s) => s.variants.reduce((a, b) => ((b.sellPrice ?? 0) > (a.sellPrice ?? 0) ? b : a)))
  .sort((a, b) => (b.sellPrice ?? 0) - (a.sellPrice ?? 0))
  .slice(0, 6);

// 関連リンク枠（同価格帯 / 人気=高額 / 同じタイプ）。同名カードは除外。
const toRelItem = (c: Card) => ({
  href: c.path,
  image: c.image,
  name: c.name,
  sub: `${c.rarity} ${c.cardNumber}`,
  price: c.sellPrice,
});
const relatedPriceBand = similarPriceByName(card.sellPrice, 6, card.name).map(toRelItem);
const relatedPopular = popularByName(6, card.name).map(toRelItem);
const relatedSameType = isPokemon ? sameTypeByName(card.energyType, 6, card.name).map(toRelItem) : [];

// 前日比・過去最高・相場コメント。ページごとに実質差のある description / 本文にする。
const ins = sellInsight(card);
const dodText =
  ins.dod != null && ins.dod !== 0
    ? `（前日比${ins.dod > 0 ? '+' : '−'}${yen(Math.abs(ins.dod))}${
        ins.dodPct != null ? `・${ins.dodPct > 0 ? '+' : '−'}${Math.abs(ins.dodPct)}%` : ''
      }）`
    : '';
const dodSentence =
  ins.dod != null && ins.dod !== 0
    ? `前日比は${ins.dod > 0 ? '+' : '−'}${yen(Math.abs(ins.dod))}${
        ins.dodPct != null ? `（${ins.dodPct > 0 ? '+' : '−'}${Math.abs(ins.dodPct)}%）` : ''
      }。`
    : ins.dod === 0
      ? '前日からは横ばいです。'
      : '';
const highText =
  ins.high != null ? `過去最高は${yen(ins.high)}${ins.highDate ? `（${ins.highDate}）` : ''}。` : '';

const crumbLabel = `${card.name}【${card.rarity}】${setCode} ${card.cardNumber}`;
const title = `${card.name}(${card.rarity}) ${setCode} ${card.cardNumber} の買取・販売価格相場`;
const description = `${card.name}(${card.rarity})の最新販売価格は${yen(card.sellPrice)}${dodText}、買取価格は${yen(
  card.buyPrice,
)}（${priceDate}時点）。${highText}${ins.comment}${card.pack}収録。`;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${card.name}(${card.rarity}) ${card.cardNumber}`,
  image: new URL(card.imageLarge, Astro.site).href,
  category: card.category,
  sku: card.cardNumber,
  description,
  ...(card.sellPrice != null
    ? {
        offers: {
          '@type': 'Offer',
          priceCurrency: 'JPY',
          price: card.sellPrice,
          availability: card.soldOut
            ? 'https://schema.org/OutOfStock'
            : 'https://schema.org/InStock',
          ...(surugayaUrl ? { url: new URL(surugayaUrl, 'https://www.suruga-ya.jp').href } : {}),
        },
      }
    : {}),
});
---

<BaseLayout title={title} description={description} path={card.path} jsonLd={jsonLd}>
  <Breadcrumbs
    items={[
      { label: 'ポケカ買取・販売価格相場TOP', href: '/' },
      { label: 'ポケモン一覧', href: '/list/' },
      { label: card.name, href: listUrl },
      { label: crumbLabel },
    ]}
  />

  <!-- 検索インデックス対象（Pagefind）: カード名・レア・型番・パック -->
  <div data-pagefind-body data-pagefind-meta={`title:${card.name}（${card.rarity}）`}>
    <section class="detail-hero">
      <div class="hero-header">
        <div class="card-head">
          <span class="badge-rarity" data-pagefind-filter="レアリティ">{card.rarity}</span>
          <h1 class="ttl">{card.name}</h1>
          <p class="ttl-sub">{setCode} {card.cardNumber} ／ {card.pack}</p>
          <span hidden data-pagefind-filter="パック">{card.pack}</span>
        </div>
        <div class="mini-actions">
          <span>お気に入り</span>
          <span>シェア</span>
        </div>
      </div>

      <figure class="hero-img">
        <img
          src={card.imageLarge}
          alt={`${card.name}(${card.rarity}) ${card.cardNumber}`}
          width="420"
          height="586"
          loading="eager"
          data-pagefind-meta="image[src], image_alt[alt]"
          onerror="this.onerror=null;this.src='/images/cards/placeholder.svg'"
        />
        <figcaption>画像出典: 駿河屋</figcaption>
      </figure>

      <div class="thumbs" aria-label="関連カード画像">
        <img src={card.image} alt="" width="48" height="67" loading="lazy" />
        {otherVariants.slice(0, 3).map((v) => <a href={v.path}><img src={v.image} alt="" width="48" height="67" loading="lazy" /></a>)}
      </div>

      <div class="detail-main">
        <div class="price-cards">
          <div class="price-card sell">
            <span class="pcap">販売価格（最安値）</span>
            <strong>{yen(card.sellPrice)}</strong>
            <span class="delta">価格は{priceDate}時点</span>
            <a href="#shops">ショップで探す</a>
          </div>
          <div class="price-card buy">
            <span class="pcap">買取価格（最高値）</span>
            <strong>{yen(card.buyPrice)}</strong>
            <span class="delta">買取可否は各ショップで確認</span>
            <a href="#buy-shops">買取価格を比較</a>
          </div>
        </div>

        <dl class="spec">
          <div><dt>カード種別</dt><dd>{card.category}</dd></div>
          <div><dt>レギュレーション</dt><dd>{setCode}</dd></div>
          <div><dt>発売日</dt><dd>{getPack(card.packSlug)?.releaseDate ?? '調査中'}</dd></div>
          <div><dt>収録パック</dt><dd><a href={`/pack/${card.packSlug}/`}>{card.pack}</a></dd></div>
          <div><dt>カード番号</dt><dd>{card.cardNumber}</dd></div>
        </dl>

        {detail && (
          <section class="battle" aria-label="カード情報">
            <div class="battle-head">
              {detail.stage && <span class="stage">{detail.stage}</span>}
              {detail.hp != null && <span class="hp">HP <b>{detail.hp}</b></span>}
              {battleType && (
                <span class="btype">タイプ<i class="ec" style={energyStyle(battleType)}>{battleType}</i></span>
              )}
            </div>

            {detail.ability && (
              <div class="battle-block">
                <span class="bh">特性</span>
                <div class="bbody">
                  <p class="wname">{detail.ability.name}</p>
                  <p class="wtext">{detail.ability.text}</p>
                </div>
              </div>
            )}

            {detail.attacks && detail.attacks.length > 0 && (
              <div class="battle-block">
                <span class="bh">ワザ</span>
                <ul class="waza">
                  {detail.attacks.map((a) => (
                    <li>
                      <div class="waza-line">
                        <span class="cost">{a.cost.map((c) => <i class="ec" style={energyStyle(c)}>{c}</i>)}</span>
                        <span class="wname">{a.name}</span>
                        {a.damage && <span class="dmg">{a.damage}</span>}
                      </div>
                      {a.text && <p class="wtext">{a.text}</p>}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <dl class="battle-foot">
              <div>
                <dt>弱点</dt>
                <dd>{detail.weakness ? (<span class="mod"><i class="ec" style={energyStyle(detail.weakness.type)}>{detail.weakness.type}</i>{detail.weakness.value}</span>) : 'なし'}</dd>
              </div>
              <div>
                <dt>抵抗力</dt>
                <dd>{detail.resistance ? (<span class="mod"><i class="ec" style={energyStyle(detail.resistance.type)}>{detail.resistance.type}</i>{detail.resistance.value}</span>) : 'なし'}</dd>
              </div>
              <div>
                <dt>にげる</dt>
                <dd>{detail.retreat != null && detail.retreat > 0 ? (<span class="cost">{Array.from({ length: detail.retreat }).map(() => <i class="ec" style={energyStyle('無')}>無</i>)}</span>) : 'なし'}</dd>
              </div>
            </dl>
          </section>
        )}
      </div>
    </section>

    <p class="lead">
      <a href={listUrl}>{card.name}</a>（{card.rarity}・{setCode} {card.cardNumber}）の最新相場は
      <strong>販売 {yen(card.sellPrice)}</strong> / <strong>買取 {yen(card.buyPrice)}</strong>です（{priceDate}時点）。{dodSentence}{highText}{ins.comment}
    </p>
  </div>
  <!-- /検索インデックス対象 -->

  <section class="market page-panel">
    <div class="market-grid" id="price-chart">
      <div class="chart-box">
        <h2>価格推移</h2>
        <PriceHistoryChart history={card.history} />
      </div>
      <aside class="market-status">
        <h2>マーケット状況</h2>
        <dl>
          <div><dt>販売中の最安値</dt><dd class="sell">{yen(card.sellPrice)}</dd></div>
          <div><dt>買取の最高値</dt><dd class="buy">{yen(card.buyPrice)}</dd></div>
          <div><dt>売り切れ</dt><dd>{card.soldOut ? 'あり' : 'なし'}</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <div id="shops" class="shops-wrap">
    <ShopLinks title="このカードを買えるショップ" shops={purchase} variant="buy" />
    <div id="buy-shops">
      <ShopLinks title="このカードを売れるショップ（買取）" shops={buybackShops} variant="sell" />
    </div>
  </div>

  {
    otherVariants.length > 0 && (
      <section class="sec">
        <h2 class="sec-h">
          {card.name} の他レアリティ
          {isPokemon && <a class="sec-link" href={listUrl}>一覧 →</a>}
        </h2>
        <ul class="rel-cards">{otherVariants.slice(0, 4).map((v) => (
          <li>
            <a href={v.path} class:list={[v.id === card.id && 'active']}>
              <img src={v.image} alt={v.name} width="78" height="109" loading="lazy" />
              <span>{v.name}</span>
              <em>{v.rarity}</em>
              <strong>販売 {yen(v.sellPrice)}</strong>
              <small class:list={[v.buyPrice == null && 'is-empty']}>
                {v.buyPrice != null ? `買取 ${yen(v.buyPrice)}` : '買取 調査中'}
              </small>
            </a>
          </li>
        ))}</ul>
      </section>
    )
  }

  {
    samePack.length > 0 && (
      <section class="sec">
        <h2 class="sec-h">「{card.pack}」の高額カード</h2>
        <ul class="pack-cards">{samePack.map((v, i) => (
          <li>
            <a href={v.path}>
              <span class="rank">{i + 1}</span>
              <img src={v.image} alt={v.name} width="96" height="134" loading="lazy" />
              <span>{v.name}</span>
              <em>{v.rarity} {v.cardNumber}</em>
              <strong>販売 {yen(v.sellPrice)}</strong>
            </a>
          </li>
        ))}</ul>
      </section>
    )
  }

  <RelatedCards title="同価格帯のカード" items={relatedPriceBand} />
  {isPokemon && <RelatedCards title={`${card.energyType}タイプのカード`} items={relatedSameType} />}
  <RelatedCards title="人気カード" items={relatedPopular} moreHref="/ranking/" />

  {overview && (
    <section class="pokemon-overview">
      <h2>{pokeName}とは？</h2>
      <p>{overview}</p>
    </section>
  )}
</BaseLayout>

<style>
  /* ヘッダー(タイトル/アクション)を1行目、画像と価格・表を2行目に置き、
     価格カードの上端を左カード画像の上端に揃える */
  .detail-hero {
    display: grid;
    grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
    grid-template-areas:
      "head   head"
      "image  main"
      "thumbs main";
    column-gap: 32px;
    align-items: start;
    padding: 14px 0 42px;
  }
  /* タイトルとアクションを全幅ヘッダーに。左カラム幅に縛られず折り返さない */
  .hero-header {
    grid-area: head;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 18px;
  }
  .card-head { min-width: 0; }
  .mini-actions { flex: none; }
  .hero-img { grid-area: image; }
  .thumbs { grid-area: thumbs; }
  .detail-main { grid-area: main; min-width: 0; }
  /* グローバルの inline-flex 中央寄せを保ちつつ、単独行＋下余白にする */
  .card-head .badge-rarity { display: flex; width: fit-content; margin-bottom: 12px; }
  .hero-img {
    margin: 0;
    text-align: center;
  }
  .hero-img img {
    width: min(100%, 340px);
    border-radius: 18px;
    display: block;
    margin: 0 auto;
    filter: drop-shadow(0 20px 28px rgba(6, 40, 95, 0.18));
  }
  .hero-img figcaption { font-size: 11px; color: var(--text-sub); text-align: center; margin-top: 8px; }
  .thumbs {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 18px;
  }
  .thumbs img {
    width: 54px;
    height: 76px;
    object-fit: contain;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
  }
  .mini-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-bottom: 12px;
  }
  .mini-actions span {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 7px;
    color: var(--brand);
    background: #fff;
    font-size: 13px;
    font-weight: 900;
  }
  .ttl {
    margin: 0;
    color: var(--text-strong);
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: 0;
    word-break: break-word;
  }
  .ttl-sub {
    margin: 8px 0 0;
    color: var(--text-sub);
    font-size: 14px;
    font-weight: 800;
    line-height: 1.55;
  }
  /* バトル情報を下部に追加した分、上部の価格カードはややコンパクトに */
  .price-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 14px;
  }
  .price-card {
    min-width: 0;
    padding: 11px 14px 10px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fff;
    text-align: center;
    box-shadow: var(--shadow-sm);
  }
  .price-card.sell { border-color: #ffd2d7; }
  .price-card.buy { border-color: #bfead1; }
  .pcap {
    display: block;
    font-size: 13.5px;
    font-weight: 900;
  }
  .sell .pcap { color: var(--accent-red); }
  .buy .pcap { color: var(--accent-green); }
  .price-card strong {
    display: block;
    margin-top: 6px;
    color: var(--text-strong);
    font-size: clamp(23px, 3.2vw, 33px);
    line-height: 1.1;
    font-weight: 900;
  }
  .sell strong { color: var(--accent-red); }
  .delta {
    display: block;
    margin: 5px 0 10px;
    color: var(--text-sub);
    font-size: 12px;
    font-weight: 800;
  }
  .price-card a {
    display: grid;
    place-items: center;
    min-height: 38px;
    border-radius: 8px;
    color: #fff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 900;
  }
  .sell a { background: linear-gradient(135deg, #f01f32, #e50012); }
  .buy a { background: linear-gradient(135deg, #25b45e, #14964a); }
  .spec {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 22px;
    margin: 18px 0 0;
    padding: 13px 22px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fff;
    box-shadow: var(--shadow-sm);
  }
  .spec div {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
  }
  .spec div:last-child { border-bottom: 0; }
  .spec dt { margin: 0; color: #14356c; font-size: 13px; font-weight: 900; }
  .spec dd { margin: 0; color: var(--text); font-size: 13px; font-weight: 700; }
  .spec a { text-decoration: none; }

  /* ===== カード情報（ワザ/弱点/抵抗力/にげる） ===== */
  .battle {
    margin-top: 14px;
    padding: 16px 20px 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fff;
    box-shadow: var(--shadow-sm);
  }
  .battle-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .battle-head .stage {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 6px;
    background: #14356c;
    color: #fff;
    font-size: 12px;
    line-height: 1;
    font-weight: 900;
  }
  .battle-head .hp { color: var(--text-strong); font-size: 14px; font-weight: 800; }
  .battle-head .hp b { font-size: 17px; }
  .battle-head .btype {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #14356c;
    font-size: 13px;
    font-weight: 900;
  }
  /* エネルギー記号チップ（丸） */
  .ec {
    display: inline-grid;
    place-items: center;
    width: 21px;
    height: 21px;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 900;
    font-style: normal;
    line-height: 1;
    flex: none;
  }
  .battle-block {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr);
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .battle-block .bh {
    color: #14356c;
    font-size: 13px;
    font-weight: 900;
  }
